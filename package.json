{
  "name": "@dsh-external/dsh-tool-result-fold",
  "description": "In-turn tool-result folding for the DeepSeek Harness stock agent loop: content-routed condensation at insertion, originals kept in the durable log, expand_result to recover them — a standalone dsh plugin",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TT-Wang/dsh-tool-result-fold.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "link:dsh": "node scripts/link-dsh.mjs"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.1.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
